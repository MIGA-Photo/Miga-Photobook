+function goToGridPage(cat, pageIndex){
+  const items = products.filter(p=>p.category===cat);
+  const pageCount = Math.max(1, Math.ceil(items.length / GRID_PAGE_SIZE));
+  const next = Math.max(0, Math.min(pageCount - 1, pageIndex));
+  if(next === (gridPages[cat] || 0)) return;
+  gridPages[cat] = next;
+  renderGrids();
+  document.getElementById(cat)?.scrollIntoView({behavior:'smooth', block:'start'});
+}
